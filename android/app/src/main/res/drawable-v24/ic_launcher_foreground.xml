<?xml version="1.0" encoding="utf-8"?>
<!-- 打飞机 · 战机自适应图标前景（与 icon.svg 同构，缩进 108dp 安全区） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:scaleX="0.72"
        android:scaleY="0.72"
        android:pivotX="256"
        android:pivotY="256">
        <!-- 机身（冰白→青→深蓝渐变 + 描边） -->
        <path
            android:pathData="M256 96 L300 300 L280 340 L256 312 L232 340 L212 300 Z"
            android:strokeColor="#c8f8ff"
            android:strokeWidth="6">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="256" android:startY="96"
                    android:endX="256" android:endY="340"
                    android:startColor="#e6ffff"
                    android:centerColor="#36e0ff"
                    android:endColor="#1f7fbf" />
            </aapt:attr>
        </path>
        <!-- 机翼 -->
        <path android:fillColor="#1f8fd0" android:pathData="M236 232 L112 352 L236 312 Z" />
        <path android:fillColor="#1f8fd0" android:pathData="M276 232 L400 352 L276 312 Z" />
        <!-- 尾焰 -->
        <path android:fillColor="#b4e6ff" android:fillAlpha="0.9" android:pathData="M244 340 L256 420 L268 340 Z" />
        <!-- 翼尖灯 -->
        <path android:fillColor="#ff5b6e" android:pathData="M120,337a9,9 0 1,0 0.1,0z" />
        <path android:fillColor="#ff5b6e" android:pathData="M392,337a9,9 0 1,0 0.1,0z" />
    </group>
</vector>
